    },
    "confidence": {
      "enum": [
        "verified",
        "secondary",
        "advisory"
      ]
    },
    "drive": {
      "enum": [
        "mrl_traction",
        "traction",
        "hydraulic",
        "holeless"
      ]
    },
    "kind": {
      "enum": [
        "passenger",
        "hospital",
        "freight",
        "vehicle",
        "lula",
        "residence",
        "platform_lift",
        "dumbwaiter"
