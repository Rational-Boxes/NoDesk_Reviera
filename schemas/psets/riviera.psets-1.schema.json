{
  "$id": "https://riviera.org/schemas/psets/riviera.psets-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riviera property set definitions",
  "description": "Property sets in Riviera's namespace (Riviera_*) for values IFC has no standard property for (spec ARC-GLZ-007). Published under the MIT licence so other tools can read them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "property_sets"],
  "properties": {
    "format": { "enum": ["riviera-psets", "reviera-psets"], "description": "reviera-psets is the old spelling, still read." },
    "version": { "type": "string" },
    "property_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "applicable_classes", "properties"],
        "properties": {
          "name": { "type": "string", "pattern": "^Riviera_[A-Za-z]+$" },
          "description": { "type": "string" },
          "applicable_classes": { "type": "array", "items": { "type": "string", "pattern": "^Ifc[A-Za-z]+$" } },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "measure", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z]+$" },
                "measure": { "type": "string", "pattern": "^Ifc[A-Za-z]+$" },
                "unit": { "type": "string" },
                "description": { "type": "string" },
                "values": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
