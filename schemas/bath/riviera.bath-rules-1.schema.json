{
  "$id": "https://riviera.org/schemas/bath/riviera.bath-rules-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riviera bathroom rule pack",
  "description": "Clearance zones, distance rules and grab-bar rules for bathroom fixtures, from one code, standard or guide (ARC-BATH-001). Lengths are metres. MIT licensed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "title", "jurisdiction", "edition", "layer"],
  "properties": {
    "format": {"enum": ["riviera.bath-rules-1", "reviera.bath-rules-1"], "description": "reviera.bath-rules-1 is the old spelling, still read."},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique among the packs a project can use; a project pack with a shipped pack's id replaces it."
    },
    "title": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1, "description": "Where it applies: US, England, …"},
    "edition": {
      "type": "string",
      "minLength": 1,
      "description": "The editions and clauses its values come from."
    },
    "layer": {
      "enum": ["minimum", "accessible", "recommended"],
      "description": "A code minimum, an accessibility standard, or guidance (findings are notes)."
    },
    "notes": {"type": "string"},
    "zones": {"type": "array", "items": {"$ref": "#/$defs/zone"}},
    "distances": {"type": "array", "items": {"$ref": "#/$defs/distance"}},
    "bars": {"type": "array", "items": {"$ref": "#/$defs/bar"}},
    "counts": {"type": "array", "items": {"$ref": "#/$defs/count"}},
    "electrical": {"$ref": "#/$defs/electrical"},
    "falls": {"$ref": "#/$defs/falls"},
    "waterproofing": {"type": "array", "items": {"$ref": "#/$defs/waterproofing"}},
    "spa": {"$ref": "#/$defs/spa"},
    "sauna": {"$ref": "#/$defs/sauna"},
    "steam": {"$ref": "#/$defs/steam"},
    "spa_access": {"$ref": "#/$defs/spa_access"},
    "whirlpool": {"$ref": "#/$defs/whirlpool"},
    "receptacles": {"$ref": "#/$defs/receptacles"}
  },
  "$defs": {
    "fixture": {"enum": ["water_closet", "urinal", "lavatory", "bidet", "bath", "shower", "locker", "bench", "spa", "sauna_heater", "steam_head"]},
    "rule": {
      "type": "object",
      "required": ["id", "description", "fixtures", "source", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The clause it comes from, e.g. `ADA 2010 604.3.1`."
        },
        "description": {"type": "string", "minLength": 1},
        "fixtures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fixture"}},
        "occupancy": {
          "enum": ["any", "dwelling", "other"],
          "description": "Where it applies, as the building code settings name occupancies (default any)."
        },
        "source": {
          "type": "string",
          "pattern": "^S[0-9]{4}( S[0-9]{4})*$",
          "description": "Source IDs in SOURCE_REGISTER.md."
        },
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "across": {
      "type": "array",
      "prefixItems": [{"enum": ["centre", "near_edge", "far_edge", "side_wall"]}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2,
      "description": "A position across the fixture: from its centreline, an edge, or its side wall, positive toward the open side (away from the side wall)."
    },
    "out": {
      "type": "array",
      "prefixItems": [{"enum": ["wall", "front"]}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2,
      "description": "A position out from the wall behind the fixture, or from the fixture's front, positive into the room."
    },
    "zone": {
      "allOf": [{"$ref": "#/$defs/rule"}],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["across", "out"],
      "properties": {
        "id": true,
        "description": true,
        "fixtures": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "across": {"type": "array", "items": {"$ref": "#/$defs/across"}, "minItems": 2, "maxItems": 2},
        "out": {"type": "array", "items": {"$ref": "#/$defs/out"}, "minItems": 2, "maxItems": 2},
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How high above the floor it is kept clear (default 1.0 m)."
        },
        "door_swing": {
          "enum": ["allowed", "forbidden"],
          "description": "Whether a door may swing into it (default allowed)."
        }
      }
    },
    "distance": {
      "allOf": [{"$ref": "#/$defs/rule"}],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["measure"],
      "properties": {
        "id": true,
        "description": true,
        "fixtures": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "measure": {"enum": ["centreline_to_side_wall"]},
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "bar": {
      "allOf": [{"$ref": "#/$defs/rule"}],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["wall", "covers", "top"],
      "properties": {
        "id": true,
        "description": true,
        "fixtures": true,
        "occupancy": true,
        "source": true,
        "confidence": true,
        "wall": {"enum": ["side", "rear"], "description": "The fixture's side wall, or the wall behind it."},
        "covers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [{"enum": ["rear_wall", "centre"]}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "The stretch the bar must cover at least: on the side wall, out from the rear wall's face; on the rear wall, across from the fixture's centreline, positive toward the open side. A bar is placed over exactly this stretch."
        },
        "top": {"$ref": "#/$defs/range", "description": "The top of the bar above the floor."},
        "diameter": {"$ref": "#/$defs/range"},
        "gap": {"$ref": "#/$defs/range", "description": "Clear space between the bar and the wall."},
        "length_min": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0},
        "default": {"type": "number", "minimum": 0}
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "occupancy", "description", "fixtures", "source", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "The table row, e.g. `IPC 403.1 B`."},
        "occupancy": {
          "type": "string",
          "minLength": 1,
          "description": "The occupancy or use the row is for (B, A-3, mixed-use workplace…)."
        },
        "description": {"type": "string", "minLength": 1},
        "fixtures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "water_closet_male": {"$ref": "#/$defs/requirement"},
            "water_closet_female": {"$ref": "#/$defs/requirement"},
            "water_closet": {"$ref": "#/$defs/requirement"},
            "urinal": {"$ref": "#/$defs/requirement"},
            "lavatory_male": {"$ref": "#/$defs/requirement"},
            "lavatory_female": {"$ref": "#/$defs/requirement"},
            "lavatory": {"$ref": "#/$defs/requirement"},
            "drinking_fountain": {"$ref": "#/$defs/requirement"},
            "shower": {"$ref": "#/$defs/requirement"},
            "service_sink": {"$ref": "#/$defs/requirement"}
          }
        },
        "urinal_substitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The share of the WCs required for males that urinals may replace."
        },
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "description": "How many of a fixture: by ratio bands (one per so many people, band by band, the sum rounded up) or by a step table (up to so many people, so many fixtures) with one more per so many beyond it.",
      "properties": {
        "basis": {
          "enum": ["male", "female", "each_sex", "total", "unit"],
          "description": "Whose number the rule counts: males, females, each sex (half the load each unless told), the whole load, or units (sleeping or dwelling units)."
        },
        "ratio": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["per"],
            "properties": {
              "to": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "The band ends at this many people (the last has none)."
              },
              "per": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "table": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "integer", "minimum": 0}],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[up to so many people, so many fixtures], ascending."
        },
        "then_per": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "With a table: one more fixture per so many people (or part) beyond its last row; without it, the last row's count holds beyond it."
        },
        "minimum": {"type": "integer", "minimum": 0}
      }
    },
    "electrical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "zone1_height",
        "trayless_radius",
        "zone2_width",
        "socket_distance",
        "ip",
        "source",
        "confidence"
      ],
      "description": "Zones round baths and showers where electrical equipment is restricted (BS 7671 Section 701 / IEC 60364-7-701).",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "zone0_trayless_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Zone 0's height for a shower without a tray (default 0.10 m)."
        },
        "zone1_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Zone 1's height above the floor, or the highest fixed shower head if higher."
        },
        "trayless_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Zone 1's radius round the head of a shower without a tray."
        },
        "zone2_width": {
          "type": "number",
          "minimum": 0,
          "description": "How far zone 2 reaches beyond zone 1, horizontally."
        },
        "socket_distance": {
          "type": "number",
          "minimum": 0,
          "description": "The least horizontal distance from zone 1 to a socket outlet."
        },
        "ip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone0", "zone1", "zone2"],
          "properties": {
            "zone0": {"type": "string", "pattern": "^IP[0-9X][0-9X]$"},
            "zone1": {"type": "string", "pattern": "^IP[0-9X][0-9X]$"},
            "zone2": {"type": "string", "pattern": "^IP[0-9X][0-9X]$"}
          }
        },
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "falls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "min", "source", "confidence"],
      "description": "The fall of a level-access shower's floor toward its drain.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The least fall, as a gradient (0.02 is 2 %, 1:50)."
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The steepest fall allowed, if any."
        },
        "default": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The fall bath.shower_falls lays when none is given."
        },
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "waterproofing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "fixtures", "wall_height", "source", "confidence"],
      "description": "Where walls and floors round some fixtures are waterproof or nonabsorbent.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}},
        "level_access_only": {"type": "boolean", "description": "Only for level-access showers (no raised tray)."},
        "wall_height": {"type": "number", "minimum": 0, "description": "Up the walls bounding the fixture, from its floor (metres)."},
        "wall_beyond": {"type": "number", "minimum": 0, "description": "How far the wall strip runs past the fixture's sides."},
        "floor": {"type": "boolean", "description": "The floor: the fixture's footprint grown by floor_front and floor_sides."},
        "floor_front": {"type": "number", "minimum": 0},
        "floor_sides": {"type": "number", "minimum": 0},
        "whole_room": {"type": "boolean", "description": "The whole floor of the room the fixture stands in (a wet room)."},
        "class": {"type": "string", "pattern": "^W[0-3]-I$", "description": "A DIN 18534 water-exposure class, as data."},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "spa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "receptacle_distance", "switch_distance", "luminaire_height", "occupant_mass", "floor_live_load", "pad_thickness", "source", "confidence"],
      "description": "Hot tubs and spas: electrical distances and the floor load.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "receptacle_distance": {"type": "number", "minimum": 0, "description": "Receptacles at least this far in plan from the tub's outline (metres)."},
        "switch_distance": {"type": "number", "minimum": 0, "description": "Wall switches at least this far in plan from the tub's outline."},
        "luminaire_height": {"type": "number", "minimum": 0, "description": "Luminaires and fans over the tub at least this far above the water."},
        "water_below_rim": {"type": "number", "minimum": 0, "description": "The water level below the rim (default 0.1 m)."},
        "occupant_mass": {"type": "number", "minimum": 0, "description": "Each seat's bather, for the floor load (kg)."},
        "floor_live_load": {"type": "number", "exclusiveMinimum": 0, "description": "The floor live load to compare with on a suspended floor (kPa)."},
        "pad_thickness": {"type": "number", "minimum": 0, "description": "The concrete pad asked for on the lowest level (metres)."},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "sauna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "heaters", "uninsulated_volume", "log_factor", "ceiling_min", "ceiling_max", "upper_bench_headroom", "sensor_below_ceiling", "source", "confidence"],
      "description": "Saunas: heater sizing by volume, the room's height, the benches and the thermostat's sensor.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "heaters": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}], "minItems": 3, "maxItems": 3},
          "description": "Heaters by power, smallest first: [kW, least room volume m³, most room volume m³]."
        },
        "uninsulated_volume": {"type": "number", "minimum": 0, "description": "m³ added to the design volume per m² of uninsulated surface."},
        "log_factor": {"type": "number", "minimum": 1, "description": "The design volume's factor for log walls."},
        "ceiling_min": {"type": "number", "exclusiveMinimum": 0},
        "ceiling_max": {"type": "number", "exclusiveMinimum": 0},
        "upper_bench_headroom": {"type": "number", "exclusiveMinimum": 0, "description": "From the upper bench's top to the ceiling."},
        "sensor_below_ceiling": {"type": "number", "minimum": 0, "description": "A thermostat sensor within this of the ceiling."},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]},
        "door": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "description", "vent", "vent_below_head", "source", "confidence"],
          "description": "The door's vent and, outside dwellings, the warning notice outside it (IMC 914).",
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "vent": {"$ref": "#/$defs/pair", "description": "The vent's least width and height in metres."},
            "vent_below_head": {"type": "number", "minimum": 0, "description": "The vent's top within this of the door's head."},
            "notice_reach": {"type": "number", "exclusiveMinimum": 0, "description": "A notice outside the door within this of it in plan, where the building is not a dwelling."},
            "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
            "confidence": {"enum": ["verified", "secondary", "advisory"]}
          }
        }
      }
    },
    "steam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "ceiling_slope", "ceiling_ideal", "ceiling_max", "floor_fall", "head_clearance", "materials", "height_base", "height_unit", "height_step", "exterior_wall", "source", "confidence"],
      "description": "Steam rooms: the ceiling's slope and height, the floor's fall, the steam head's distance from benches, and a generator's design-volume factors.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "ceiling_slope": {"type": "number", "exclusiveMinimum": 0, "description": "The ceiling's least slope, as a gradient (2 in per ft is 0.1667)."},
        "ceiling_ideal": {"type": "number", "exclusiveMinimum": 0},
        "ceiling_max": {"type": "number", "exclusiveMinimum": 0},
        "floor_fall": {"type": "number", "exclusiveMinimum": 0},
        "head_clearance": {"type": "number", "minimum": 0},
        "materials": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}, "description": "The walls' material factors on the room's volume."},
        "height_base": {"type": "number", "minimum": 0},
        "height_unit": {"type": "number", "exclusiveMinimum": 0},
        "height_step": {"type": "number", "minimum": 0},
        "exterior_wall": {"type": "number", "minimum": 0},
        "generator_run": {"type": "number", "exclusiveMinimum": 0, "description": "The longest steam line from the generator to the head (metres)."},
        "control_height": {"$ref": "#/$defs/pair", "description": "The control pad's height above the floor, least and most (metres)."},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "pair": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}], "minItems": 2, "maxItems": 2},
    "spa_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "turning_diameter", "bench_height", "bench_depth", "bench_length", "entries", "entry_reach", "transfer_wall_height", "transfer_wall_depth", "transfer_wall_length", "source", "confidence"],
      "description": "Accessible saunas, steam rooms and spas: the turning space, an accessible bench, and a spa's means of entry.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "turning_diameter": {"type": "number", "exclusiveMinimum": 0},
        "bench_height": {"$ref": "#/$defs/pair", "description": "An accessible bench's top, least and most (metres)."},
        "bench_depth": {"$ref": "#/$defs/pair"},
        "bench_length": {"type": "number", "exclusiveMinimum": 0},
        "entries": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "The ObjectTypes that are means of entry to a spa."},
        "entry_reach": {"type": "number", "minimum": 0, "description": "A means of entry within this of the spa's outline (metres)."},
        "transfer_wall_height": {"$ref": "#/$defs/pair"},
        "transfer_wall_depth": {"$ref": "#/$defs/pair"},
        "transfer_wall_length": {"type": "number", "exclusiveMinimum": 0},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "whirlpool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "opening", "clear_depth", "source", "confidence"],
      "description": "A whirlpool bath's pump access: the opening in its apron at the pump, and the space kept clear in front of it. The pump's position is the bath type's WhirlpoolBath.PumpPosition.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "opening": {"type": "number", "exclusiveMinimum": 0, "description": "The opening's least width and height (metres)."},
        "clear_depth": {"type": "number", "exclusiveMinimum": 0, "description": "Kept clear in front of it (metres)."},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    },
    "receptacles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "tub_zone", "tub_zone_height", "basin_reach", "source", "confidence"],
      "description": "US-style receptacle rules: none near a tub or shower, and one near each basin.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "tub_zone": {"type": "number", "minimum": 0, "description": "No receptacle within this of a tub's or shower's outside edge (metres, in plan)."},
        "tub_zone_height": {"type": "number", "minimum": 0, "description": "... up to this above its rim or threshold."},
        "basin_reach": {"type": "number", "minimum": 0, "description": "In a dwelling, a receptacle within this of each basin's outside edge."},
        "source": {"type": "string", "pattern": "^S[0-9]{4}( S[0-9]{4})*$"},
        "confidence": {"enum": ["verified", "secondary", "advisory"]}
      }
    }
  }
}
