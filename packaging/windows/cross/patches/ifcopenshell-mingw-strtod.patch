+// std::from_chars is locale-independent. The stringstream this replaces gave tellg() == -1 when
+// the number ran to the end of the token, so such real numbers were rejected.
+double strtod_l(const char* start, char** end, locale_t) {
+    double d = 0.;
+    const char* first = *start == '+' ? start + 1 : start;
+    auto r = std::from_chars(first, first + std::strlen(first), d);
+    *end = const_cast<char*>(r.ec == std::errc() ? r.ptr : start);
